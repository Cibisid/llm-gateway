# Copy to .env and edit. Names only — never commit real values.
# soleradar needs NO credentials to run; everything here is optional.

# --- live sources (off by default) ------------------------------------------
# Turning this on makes the app fetch from third-party endpoints. Read the ToS
# note in api/soleradar/sources/live.py before you do.
SOLERADAR_ENABLE_LIVE=0
SOLERADAR_SOURCES=rss,nike,stockx,goat

# --- product imagery ---------------------------------------------------------
# On by default. Fetching a product photo is not the same as scraping a price.
SOLERADAR_FETCH_IMAGES=1
SOLERADAR_IMAGE_WORKERS=4

# --- refresh cadence (minutes) -----------------------------------------------
SOLERADAR_MARKET_INTERVAL_MIN=20
SOLERADAR_NEWS_INTERVAL_MIN=60
SOLERADAR_CALENDAR_INTERVAL_MIN=360
SOLERADAR_HOT_INTERVAL_MIN=5
SOLERADAR_HOT_WINDOW_HOURS=48

# --- server ------------------------------------------------------------------
SOLERADAR_HOST=127.0.0.1
SOLERADAR_PORT=8787
SOLERADAR_DATA_DIR=./var
SOLERADAR_REGION=US
SOLERADAR_CURRENCY=USD
