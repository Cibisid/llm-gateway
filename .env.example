# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- providers ---
# Anthropic (currently the only live provider in this project)
ANTHROPIC_API_KEY=

# OpenAI (adapter is implemented but unverified until a real key is present)
OPENAI_API_KEY=

# Azure OpenAI (uses the `openai` SDK against an Azure endpoint)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# --- gateway auth ---
# Comma-separated API keys clients present as `Authorization: Bearer <key>`.
# EMPTY MEANS THE SERVICE REFUSES EVERY REQUEST WITH 503. It fails closed on
# purpose: an auth layer that disables itself when unconfigured is worse than
# none, because the deployment looks protected.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEYS=

# Requests per key per minute. Per-process, so N replicas allow N x this.
RATE_LIMIT_PER_MINUTE=60

# --- audit logging ---
# Where the JSON audit stream goes. Empty = stdout (right for containers).
AUDIT_LOG_PATH=

# Log prompt and response text. OFF by default, and it should usually stay off:
# prompts routinely contain customer data and credentials people paste in.
# When true, content is redacted and truncated first - but not logging it at
# all is the control that actually protects it.
AUDIT_LOG_CONTENT=false

# --- routing ---
# How the router ranks candidates: order | cost | latency
ROUTING_STRATEGY=order

# --- runtime ---
LOG_LEVEL=INFO
