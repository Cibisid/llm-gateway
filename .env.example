# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- providers ---
# Anthropic (currently the only live provider in this project)
ANTHROPIC_API_KEY=

# OpenAI (adapter is implemented but unverified until a real key is present)
OPENAI_API_KEY=

# Azure OpenAI (uses the `openai` SDK against an Azure endpoint)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# --- gateway auth ---
# Comma-separated API keys that clients must present as `Authorization: Bearer <key>`.
GATEWAY_API_KEYS=

# --- runtime ---
LOG_LEVEL=INFO
